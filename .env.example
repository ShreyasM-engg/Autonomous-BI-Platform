# OLLAMA_API_KEY: Your Ollama API key (for Ollama Cloud https://ollama.com or authenticated Ollama endpoints).
OLLAMA_API_KEY=""

# OLLAMA_BASE_URL: Ollama endpoint URL (use https://ollama.com for Ollama API key, or http://localhost:11434 for local Ollama).
OLLAMA_BASE_URL="https://ollama.com"

# OLLAMA_MODEL: Ollama Cloud model name (e.g. gpt-oss:120b, gpt-oss:20b, or deepseek-v4-pro:0813).
OLLAMA_MODEL="gpt-oss:120b"

